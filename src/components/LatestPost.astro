---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

// Same ordering as the blog index: newest date first, then highest post number.
const postNumber = (post: CollectionEntry<"blog">) =>
  Number(post.id.split("/")[0]) || 0;

const post = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime() ||
    postNumber(b) - postNumber(a),
)[0];
const slug = post?.id.split("/").pop()?.replace(/\.md$/, "");
---

{
  post && (
    <a href={`/blog/${slug}`} class="card group block">
      <div class="flex items-start justify-between gap-4 mb-2">
        <h4 class="font-display text-xl font-semibold t-text group-hover-accent transition-colors">
          {post.data.title}
        </h4>
        <time class="font-mono text-xs t-muted shrink-0 mt-1">{post.data.date}</time>
      </div>
      <p class="t-muted text-sm leading-relaxed mb-4">{post.data.description}</p>
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map((tag) => (
          <span class="whitespace-nowrap font-mono text-xs t-muted b-border border px-2 py-1 rounded">
            {tag}
          </span>
        ))}
      </div>
    </a>
  )
}
