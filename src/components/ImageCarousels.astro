---
// Turns every <div class="carousel"> inside Markdown content into an image
// carousel. Write it in a post or project page like this:
//
//   <div class="carousel">
//     <img src="https://raw.githubusercontent.com/.../media/one.jpg" alt="First" />
//     <img src="https://raw.githubusercontent.com/.../media/two.jpg" alt="Second" />
//   </div>
//
// Markdown images work too, if they sit between blank lines inside the div:
//
//   <div class="carousel">
//
//   ![First](media/one.jpg "Optional caption")
//   ![Second](media/two.jpg)
//
//   </div>
//
// An image's title (the quoted text in Markdown, or title="..." on an <img>)
// becomes its caption.
---

<script>
  document.querySelectorAll<HTMLElement>(".prose-content .carousel").forEach((root) => {
    const images = Array.from(root.querySelectorAll("img"));
    if (images.length === 0) return;

    const track = document.createElement("div");
    track.className = "carousel-track";
    track.tabIndex = 0;

    const slides = images.map((img, i) => {
      const slide = document.createElement("figure");
      slide.className = "carousel-slide";
      slide.setAttribute("aria-roledescription", "slide");
      slide.setAttribute("aria-label", `${i + 1} of ${images.length}`);
      img.loading = i === 0 ? "eager" : "lazy";
      slide.append(img);
      const caption = img.getAttribute("title");
      if (caption) {
        const fig = document.createElement("figcaption");
        fig.textContent = caption;
        slide.append(fig);
      }
      track.append(slide);
      return slide;
    });

    root.replaceChildren(track);
    root.setAttribute("role", "region");
    root.setAttribute("aria-roledescription", "carousel");
    if (images.length < 2) return;

    const button = (label: string, text: string) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "carousel-btn";
      b.setAttribute("aria-label", label);
      b.textContent = text;
      return b;
    };
    const prev = button("Previous image", "←");
    const next = button("Next image", "→");
    const counter = document.createElement("span");
    counter.className = "carousel-counter";
    const nav = document.createElement("div");
    nav.className = "carousel-nav";
    nav.append(prev, counter, next);
    root.append(nav);

    let current = 0;
    const show = () => (counter.textContent = `${current + 1} / ${slides.length}`);
    const go = (i: number) => {
      current = (i + slides.length) % slides.length;
      track.scrollTo({ left: current * track.clientWidth, behavior: "smooth" });
      show();
    };
    show();

    // Keep the counter right when the user swipes or scrolls the track.
    track.addEventListener(
      "scroll",
      () => {
        current = Math.round(track.scrollLeft / track.clientWidth);
        show();
      },
      { passive: true },
    );
    prev.addEventListener("click", () => go(current - 1));
    next.addEventListener("click", () => go(current + 1));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") (e.preventDefault(), go(current - 1));
      if (e.key === "ArrowRight") (e.preventDefault(), go(current + 1));
    });
  });
</script>

<style is:global>
  .prose-content .carousel {
    margin-bottom: 1.25rem;
  }
  .prose-content .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background-color: var(--surface);
  }
  .prose-content .carousel-track::-webkit-scrollbar {
    display: none;
  }
  .prose-content .carousel-track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Every slide is as tall as the tallest image; shorter ones sit centred. */
  .prose-content .carousel-slide {
    flex: 0 0 100%;
    min-width: 0;
    margin: 0;
    padding: 0.75rem;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .prose-content .carousel-slide img {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 0.375rem;
  }
  .prose-content .carousel-slide figcaption {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    text-align: center;
  }
  .prose-content .carousel-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .prose-content .carousel-counter {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    min-width: 3.5rem;
    text-align: center;
  }
  .prose-content .carousel-btn {
    font-family: var(--font-mono);
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.25rem 0.75rem;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .prose-content .carousel-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
