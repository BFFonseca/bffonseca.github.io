---
// Thumbnail image for blog posts and projects (picked by lib/thumbnail.ts).
//   variant="strip" -> thin cropped preview strip used on index cards
//   variant="hero"  -> full-width banner at the top of the post/project page
// Crop = defaults from site.config.ts, then the entry's `thumbnailCrop`, then its
// variant-specific `thumbnailCrop.strip` / `thumbnailCrop.hero`.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { thumbnails } from '../site.config';

interface Crop {
  x?: number;
  y?: number;
  zoom?: number;
}

interface Props {
  src: ImageMetadata;
  alt?: string;
  crop?: Crop & { strip?: Crop; hero?: Crop };
  variant: 'strip' | 'hero';
  class?: string;
}

const { src, alt = '', crop = {}, variant, class: className = '' } = Astro.props;
const isHero = variant === 'hero';
const defaults = thumbnails[variant];

const pick = (key: keyof Crop) => crop[variant]?.[key] ?? crop[key] ?? defaults[key];
const x = pick('x');
const y = pick('y');
const zoom = pick('zoom');

// With object-fit: cover, the image's x%/y% point lines up with the box's x%/y% point,
// so using the same values for transform-origin zooms in around that focal point.
const imgStyle = [
  `object-position: ${x}% ${y}%`,
  zoom !== 1 && `transform: scale(${zoom})`,
  zoom !== 1 && `transform-origin: ${x}% ${y}%`,
].filter(Boolean).join('; ');

const boxStyle = typeof defaults.height === 'string'
  ? `--thumb-h-sm: ${defaults.height}`
  : `--thumb-h-sm: ${defaults.height.mobile}; --thumb-h-md: ${defaults.height.desktop}`;
---

<div class:list={['thumb', isHero ? 'thumb-hero' : 'thumb-strip', className]} style={boxStyle}>
  <Image
    src={src}
    alt={alt}
    widths={isHero ? [768, 1200, 1600] : [480, 768, 1200]}
    sizes={isHero ? '(min-width: 768px) 768px, 100vw' : '(min-width: 768px) 720px, 100vw'}
    loading={isHero ? 'eager' : 'lazy'}
    style={imgStyle}
  />
</div>
