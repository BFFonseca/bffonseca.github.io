---
// Thumbnail for a blog post or project.
//   variant="strip" -> thin cropped preview strip used on index cards
//   variant="hero"  -> full-width banner at the top of the post/project page
// Image and crop are resolved separately for desktop (>= 768px) and phones, from the entry's
// `thumbnailCrop` frontmatter and the defaults in site.config.ts (see lib/thumbnail.ts).
// Renders nothing when the entry has no thumbnail; if only one screen has one (`image: none` on the
// other), it's hidden on the other screen.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { resolveSlot, type Variant } from '../lib/thumbnail';
import { thumbnails } from '../site.config';

interface Props {
  entry: CollectionEntry<'blog'> | CollectionEntry<'projects'>;
  variant: Variant;
  href?: string; // wrap the thumbnail in a (non-focusable) link
  class?: string;
}

const { entry, variant, href, class: className = '' } = Astro.props;
const Wrapper = href ? 'a' : Fragment;
const wrapperProps = href ? { href, tabindex: -1, 'aria-hidden': 'true' } : {};
const isHero = variant === 'hero';
const defaults = thumbnails[variant];

const desktop = resolveSlot(entry, variant, 'desktop', defaults);
const mobile = resolveSlot(entry, variant, 'mobile', defaults);

const widths = isHero ? [768, 1200, 1600] : [480, 768, 1200];
const sizes = isHero ? '(min-width: 768px) 768px, 100vw' : '(min-width: 768px) 720px, 100vw';
const optimise = (src: ImageMetadata) => getImage({ src, widths, sizes });

// A screen without a thumbnail borrows the other screen's values and is hidden with CSS.
const shownDesktop = desktop ?? mobile;
const shownMobile = mobile ?? desktop;
const hide = !desktop ? 'thumb-hide-md' : !mobile ? 'thumb-hide-sm' : '';

const [desktopImg, mobileImg] = shownDesktop && shownMobile
  ? await Promise.all([
      optimise(shownDesktop.src),
      shownDesktop.src === shownMobile.src ? null : optimise(shownMobile.src),
    ])
  : [null, null];

// Crop values go in CSS variables; global.css switches from the -sm to the -md set at 768px.
const vars = (s: { x: number; y: number; zoom: number }, suffix: string) =>
  `--tx-${suffix}: ${s.x}%; --ty-${suffix}: ${s.y}%; --tz-${suffix}: ${s.zoom}`;
const height = typeof defaults.height === 'string'
  ? `--thumb-h-sm: ${defaults.height}`
  : `--thumb-h-sm: ${defaults.height.mobile}; --thumb-h-md: ${defaults.height.desktop}`;
const style = shownDesktop && shownMobile ? [height, vars(shownMobile, 'sm'), vars(shownDesktop, 'md')].join('; ') : '';
---

{shownDesktop && shownMobile && desktopImg && (
  <Wrapper {...wrapperProps}>
  <div class:list={['thumb', isHero ? 'thumb-hero' : 'thumb-strip', hide, className]} style={style}>
    <picture>
      {mobileImg && <source media="(min-width: 768px)" srcset={desktopImg.srcSet.attribute} sizes={sizes} />}
      <img
        src={(mobileImg ?? desktopImg).src}
        srcset={(mobileImg ?? desktopImg).srcSet.attribute}
        sizes={sizes}
        alt={shownMobile.alt}
        width={(mobileImg ?? desktopImg).attributes.width}
        height={(mobileImg ?? desktopImg).attributes.height}
        loading={isHero ? 'eager' : 'lazy'}
        decoding="async"
      />
    </picture>
  </div>
  </Wrapper>
)}
