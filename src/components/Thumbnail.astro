---
// Thumbnail image for blog posts and projects, set via the `thumbnail`
// frontmatter field (a path relative to the .md file, e.g. ./media/thumb.jpg).
//   variant="strip" -> thin cropped preview strip used on index cards
//   variant="hero"  -> full-width banner at the top of the post/project page
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  position?: string; // CSS object-position, e.g. "center 30%"
  variant: 'strip' | 'hero';
  class?: string;
}

const { src, alt = '', position = 'center', variant, class: className = '' } = Astro.props;
const isHero = variant === 'hero';
---

<Image
  src={src}
  alt={alt}
  widths={isHero ? [768, 1200, 1600] : [480, 768, 1200]}
  sizes={isHero ? '(min-width: 768px) 768px, 100vw' : '(min-width: 768px) 720px, 100vw'}
  loading={isHero ? 'eager' : 'lazy'}
  class:list={['thumb', isHero ? 'thumb-hero' : 'thumb-strip', className]}
  style={`object-position: ${position};`}
/>
