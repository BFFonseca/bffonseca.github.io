---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="mb-20">
  <hgroup class="mb-10">
    <h1 class="font-display text-5xl font-bold t-text leading-tight mb-2">
      Welcome to <span class="t-accent">DebugLED</span>
    </h1>
    <p class="font-display text-3xl font-bold t-text leading-snug">
      The most critical component.
    </p>
  </hgroup>
    <p class="t-muted text-lg leading-relaxed mb-8">
      I'm Bruno. Developer, maker, and occasional writer. This is where I document my
      projects, share what I learn, and keep an online presence of my own.
    </p>
    <div class="flex gap-4">
      <a href="/projects" class="btn-primary">View Projects</a>
      <a href="/blog" class="btn-outline">Read Blog</a>
    </div>
  </section>

  <!-- About -->
  <section class="mb-20">
    <h2 class="section-title">About</h2>
    <p class="led-accent text-sm mb-6">// who I am</p>
    <div class="card">
      <p class="t-muted leading-relaxed mb-4">
        My name's Bruno and I love to build things and watch cool stuff happen!
      </p>
      <p class="t-muted leading-relaxed">
        Currently working on: <span class="t-text">a Linux Server</span><br />
        I had some PC spare parts lying around and have been thinking of having my own little server for a while.<br />
        Find out more on <a
          href="/projects/project-home-server"
          class="t-accent hover:underline">the project page</a>.
      </p>
    </div>
  </section>

  <!-- Skills / Stack -->
  <section>
    <h2 class="section-title">Toolbox</h2>
    <p class="led-accent text-sm mb-6">// these are the tools I use</p>
    <div class="flex flex-wrap gap-2">
      {
        [
          "C",
          "C++",
          "Python",
          "Git",
          "bash",
          "VSCode",
          "ESP-IDF",
          "STM32CubeIDE",
          "Antigravity IDE",
          "Claude",
          "ChatGPT",
          "OrcaSlicer",
          "Autodesk Fusion",
          "KiCad",
          "HomeAssistant",
          "DaVinci Resolve",
          "Godot Engine",
        ].map((skill) => (
          <span class="skill-tag font-mono text-xs px-3 py-1.5 rounded-full border t-muted b-border hover-accent transition-colors">
            {skill}
          </span>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .skill-tag:hover {
    border-color: var(--accent);
  }
</style>
