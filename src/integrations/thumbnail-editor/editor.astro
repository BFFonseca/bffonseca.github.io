---
// Dev-only page (see ./index.ts): interactive thumbnail image + crop editor.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entryImages, getThumbnail } from '../../lib/thumbnail';
import { thumbnails } from '../../site.config';
import { SAVE_ENDPOINT } from './index';

const blog = await getCollection('blog');
const projects = await getCollection('projects');

const entries = [
  ...blog.map((e) => ({ e, collection: 'blog' as const })),
  ...projects.map((e) => ({ e, collection: 'projects' as const })),
]
  .map(({ e, collection }) => {
    const images = entryImages(e);
    if (!images.length || !e.filePath) return undefined;
    const auto = getThumbnail(e);
    return {
      key: `${collection}/${e.id}`,
      collection,
      title: e.data.title + ('draft' in e.data && e.data.draft ? ' (draft)' : ''),
      file: e.filePath.replace(/\\/g, '/'),
      images: images.map((i) => ({ path: i.path, url: i.src.src, w: i.src.width, h: i.src.height })),
      auto: images.find((i) => i.src === auto?.src)?.path ?? null,
      crop: e.data.thumbnailCrop ?? {},
    };
  })
  .filter((x) => x !== undefined);

const data = JSON.stringify({ entries, defaults: thumbnails, saveEndpoint: SAVE_ENDPOINT }).replace(/</g, '\\u003c');
---

<BaseLayout title="Thumbnail editor">
  <section class="te">
    <a href="/dev" class="font-mono text-sm t-muted hover-accent transition-colors mb-8 inline-block">← back to dev tools</a>
    <h1 class="section-title text-3xl mb-2">Thumbnail editor</h1>
    <p class="led-accent text-sm mb-8">// dev only · drag a frame to choose what's shown, scroll or use the slider to zoom</p>

    {entries.length === 0 ? (
      <p class="t-muted font-mono">// no posts or projects with images yet.</p>
    ) : (
      <>
        <div class="te-bar">
          <label class="te-field te-grow">
            <span>Entry</span>
            <select id="te-entry">
              {entries.map((x) => <option value={x.key}>{x.collection} · {x.title}</option>)}
            </select>
          </label>
          <div class="te-field">
            <span>Thumbnail</span>
            <div class="te-tabs" id="te-variant">
              <button type="button" data-v="base">Both</button>
              <button type="button" data-v="strip">Strip</button>
              <button type="button" data-v="hero">Banner</button>
            </div>
          </div>
          <div class="te-field">
            <span>Screen</span>
            <div class="te-tabs" id="te-screen">
              <button type="button" data-s="all">Both</button>
              <button type="button" data-s="desktop">Desktop</button>
              <button type="button" data-s="mobile">Phone</button>
            </div>
          </div>
        </div>
        <p class="te-editing font-mono text-xs t-muted" id="te-editing"></p>

        <div class="te-stage" id="te-stage">
          <img id="te-img" alt="" draggable="false" />
          <div class="te-frame te-frame-strip" data-v="strip" data-s="desktop"><span>strip</span></div>
          <div class="te-frame te-frame-strip te-frame-mobile" data-v="strip" data-s="mobile"><span>strip · phone</span></div>
          <div class="te-frame te-frame-hero" data-v="hero" data-s="desktop"><span>banner</span></div>
          <div class="te-frame te-frame-hero te-frame-mobile" data-v="hero" data-s="mobile"><span>banner · phone</span></div>
        </div>
        <p class="te-legend t-muted">
          <span class="te-key te-key-strip"></span> strip
          <span class="te-key te-key-hero"></span> banner
          <span class="te-key te-key-mobile"></span> dashed = phone
          <span class="te-note">· only frames using the image shown here are drawn</span>
        </p>

        <div class="te-controls">
          <div class="te-row">
            <label class="te-field te-grow">
              <span>Image</span>
              <select id="te-image"></select>
            </label>
            <label class="te-field te-zoom">
              <span>Zoom <b id="te-zoom-val"></b></span>
              <input id="te-zoom" type="range" min="1" max="4" step="0.01" />
            </label>
          </div>
          <div class="te-actions">
            <button type="button" class="btn-outline" id="te-clear">Clear selection</button>
            <button type="button" class="btn-outline" id="te-reset">Reset all</button>
            <button type="button" class="btn-outline" id="te-copy">Copy YAML</button>
            <button type="button" class="btn-primary" id="te-save">Save to file</button>
          </div>
          <p class="te-status font-mono text-sm" id="te-status"></p>
        </div>

        <h2 class="font-display text-xl font-semibold t-text mt-10 mb-4">Previews</h2>
        <div class="te-previews">
          <figure><figcaption data-cap="strip-desktop">Strip · desktop</figcaption><div class="te-pv" data-v="strip" data-s="desktop"><img alt="" /></div></figure>
          <figure><figcaption data-cap="hero-desktop">Banner · desktop</figcaption><div class="te-pv" data-v="hero" data-s="desktop"><img alt="" /></div></figure>
          <div class="te-pv-row">
            <figure><figcaption data-cap="strip-mobile">Strip · phone</figcaption><div class="te-pv" data-v="strip" data-s="mobile"><img alt="" /></div></figure>
            <figure><figcaption data-cap="hero-mobile">Banner · phone</figcaption><div class="te-pv" data-v="hero" data-s="mobile"><img alt="" /></div></figure>
          </div>
        </div>

        <h2 class="font-display text-xl font-semibold t-text mt-10 mb-2">Frontmatter</h2>
        <pre class="te-yaml" id="te-yaml"></pre>
      </>
    )}
  </section>

  <script type="application/json" id="te-data" set:html={data} />
</BaseLayout>

<script>
  type Slot = { x?: number; y?: number; zoom?: number; image?: string };
  type VariantCrop = Slot & { desktop?: Slot; mobile?: Slot };
  type Crop = Slot & { strip?: VariantCrop; hero?: VariantCrop };
  type Variant = 'strip' | 'hero';
  type Screen = 'desktop' | 'mobile';
  type Layer = { v: 'base' | Variant; s: 'all' | Screen };
  interface Img { path: string; url: string; w: number; h: number }
  interface Entry { key: string; collection: 'blog' | 'projects'; title: string; file: string; images: Img[]; auto: string | null; crop: Crop }
  interface Defaults { x: number; y: number; zoom: number; height: string | { mobile: string; desktop: string } }

  const dataEl = document.getElementById('te-data');
  if (dataEl) init(JSON.parse(dataEl.textContent!));

  function init({ entries, defaults, saveEndpoint }: { entries: Entry[]; defaults: Record<Variant, Defaults>; saveEndpoint: string }) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const select = $<HTMLSelectElement>('te-entry');
    const imageSelect = $<HTMLSelectElement>('te-image');
    const stage = $<HTMLDivElement>('te-stage');
    const stageImg = $<HTMLImageElement>('te-img');
    const zoom = $<HTMLInputElement>('te-zoom');
    const status = $<HTMLParagraphElement>('te-status');
    const NUM = ['x', 'y', 'zoom'] as const;
    const VARIANTS: Variant[] = ['strip', 'hero'];
    const SCREENS: Screen[] = ['desktop', 'mobile'];
    const SLOTS = VARIANTS.flatMap((v) => SCREENS.map((s) => ({ v, s })));
    const NAME = { strip: 'strip', hero: 'banner', desktop: 'desktop', mobile: 'phone' } as const;

    // Reference sizes of the real boxes on the site (content column is max-w-4xl minus padding).
    const VIEWPORT: Record<Screen, number> = { desktop: 1280, mobile: 375 };
    const content = (s: Screen) => Math.min(VIEWPORT[s], 896) - 48;
    const width = (v: Variant, s: Screen) =>
      v === 'strip' ? content(s) - 50 /* card padding + border */
        : entry.collection === 'blog' ? Math.min(content(s), 768) : content(s);
    const height = (v: Variant, s: Screen) => {
      const h = defaults[v].height;
      const css = typeof h === 'string' ? h : h[s];
      return css.replace(/([\d.]+)vw/g, (_, n) => `${(Number(n) * VIEWPORT[s]) / 100}px`);
    };
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;visibility:hidden;width:0';
    document.body.append(probe);
    const px = (css: string) => { probe.style.height = css; return probe.getBoundingClientRect().height; };

    const state = new Map(entries.map((e) => [e.key, structuredClone(e.crop) as Crop]));
    let entry = entries[0];
    let layer: Layer = { v: 'base', s: 'all' };

    const hashParams = new URLSearchParams(location.hash.slice(1));
    entry = entries.find((e) => e.key === hashParams.get('entry')) ?? entry;
    const hv = hashParams.get('v'), hs = hashParams.get('s');
    if (hv === 'base' || hv === 'strip' || hv === 'hero') layer.v = hv;
    if (hs === 'all' || hs === 'desktop' || hs === 'mobile') layer.s = hs;
    if (layer.v === 'base') layer.s = 'all';

    const crop = () => state.get(entry.key)!;

    // Levels for a slot, most specific first: [variant.screen, variant, base].
    const levels = (v: Variant, s: Screen): (Slot | undefined)[] => [crop()[v]?.[s], crop()[v], crop()];
    const layerIndex = (l: Layer) => (l.v === 'base' ? 2 : l.s === 'all' ? 1 : 0);
    const target = (l: Layer = layer): Slot => {
      const c = crop();
      if (l.v === 'base') return c;
      const vc = (c[l.v] ??= {});
      return l.s === 'all' ? vc : (vc[l.s] ??= {});
    };
    const affects = (v: Variant, s: Screen) => layer.v === 'base' || (layer.v === v && (layer.s === 'all' || layer.s === s));
    const imgByPath = (p?: string | null) => entry.images.find((i) => i.path === p);

    const eff = (v: Variant, s: Screen) => {
      const ls = levels(v, s);
      const pick = <K extends keyof Slot>(k: K) => ls.find((l) => l?.[k] !== undefined)?.[k];
      const img = imgByPath(pick('image')) ?? imgByPath(entry.auto) ?? entry.images[0];
      return { img, x: pick('x') ?? defaults[v].x, y: pick('y') ?? defaults[v].y, zoom: pick('zoom') ?? defaults[v].zoom };
    };
    // First slot the current selection affects; its image is shown on the stage.
    const focus = () => SLOTS.find(({ v, s }) => affects(v, s))!;

    // Visible part of the image for a slot, as fractions of the image (same maths as object-fit: cover
    // + object-position x% y% + scale(zoom) around the same point).
    function region(v: Variant, s: Screen) {
      const { img, x, y, zoom } = eff(v, s);
      const W = width(v, s), H = px(height(v, s));
      const sc = Math.max(W / img.w, H / img.h) * zoom;
      const fw = Math.min(1, W / (img.w * sc)), fh = Math.min(1, H / (img.h * sc));
      return { left: (x / 100) * (1 - fw), top: (y / 100) * (1 - fh), fw, fh };
    }

    function prune(c: Crop): Crop {
      const empty = (o: object | undefined) => !o || Object.keys(o).length === 0;
      for (const v of VARIANTS) {
        const vc = c[v];
        if (!vc) continue;
        for (const s of SCREENS) if (empty(vc[s])) delete vc[s];
        if (empty(vc)) delete c[v];
      }
      return c;
    }

    function render() {
      const hash = `#entry=${encodeURIComponent(entry.key)}&v=${layer.v}&s=${layer.s}`;
      if (location.hash !== hash) history.replaceState(null, '', hash);
      select.value = entry.key;
      document.querySelectorAll<HTMLButtonElement>('#te-variant button').forEach((b) => b.classList.toggle('on', b.dataset.v === layer.v));
      document.querySelectorAll<HTMLButtonElement>('#te-screen button').forEach((b) => {
        b.classList.toggle('on', b.dataset.s === layer.s);
        b.disabled = layer.v === 'base' && b.dataset.s !== 'all';
      });
      $('te-editing').textContent = layer.v === 'base'
        ? 'editing: shared settings (all four thumbnails, unless one overrides a value)'
        : `editing: ${NAME[layer.v]} · ${layer.s === 'all' ? 'desktop + phone' : NAME[layer.s]} only`;

      const f = focus();
      const shown = eff(f.v, f.s);
      if (stageImg.getAttribute('src') !== shown.img.url) stageImg.src = shown.img.url;
      stage.style.aspectRatio = `${shown.img.w} / ${shown.img.h}`;
      stage.style.width = `min(100%, calc(70vh * ${shown.img.w / shown.img.h}))`;

      stage.querySelectorAll<HTMLElement>('.te-frame').forEach((fr) => {
        const v = fr.dataset.v as Variant, s = fr.dataset.s as Screen;
        const sameImg = eff(v, s).img === shown.img;
        fr.hidden = !sameImg;
        if (!sameImg) return;
        const r = region(v, s);
        Object.assign(fr.style, { left: `${r.left * 100}%`, top: `${r.top * 100}%`, width: `${r.fw * 100}%`, height: `${r.fh * 100}%` });
        const active = affects(v, s);
        fr.classList.toggle('active', active);
        fr.classList.toggle('grab', active && (s === 'desktop' || layer.s === 'mobile'));
      });

      document.querySelectorAll<HTMLElement>('.te-pv').forEach((box) => {
        const v = box.dataset.v as Variant, s = box.dataset.s as Screen;
        const e = eff(v, s);
        box.style.width = `${width(v, s)}px`;
        box.style.height = height(v, s);
        box.classList.toggle('active', affects(v, s));
        const pi = box.querySelector('img')!;
        if (pi.getAttribute('src') !== e.img.url) pi.src = e.img.url;
        Object.assign(pi.style, { objectPosition: `${e.x}% ${e.y}%`, transform: `scale(${e.zoom})`, transformOrigin: `${e.x}% ${e.y}%` });
        const cap = document.querySelector(`[data-cap="${v}-${s}"]`)!;
        cap.textContent = `${NAME[v][0].toUpperCase() + NAME[v].slice(1)} · ${NAME[s]} — ${e.img.path} · x ${e.x.toFixed(1)} y ${e.y.toFixed(1)} · ${e.zoom.toFixed(2)}×`;
      });

      // Image picker for the current selection.
      const own = target().image;
      const inherited = (() => { const t = target(); const keep = t.image; delete t.image; const p = eff(f.v, f.s).img.path; if (keep !== undefined) t.image = keep; return p; })();
      imageSelect.innerHTML = '';
      imageSelect.append(new Option(`inherit (${inherited})`, ''));
      for (const i of entry.images) imageSelect.append(new Option(i.path + (i.path === entry.auto ? '  · automatic pick' : ''), i.path));
      imageSelect.value = own ?? '';

      zoom.value = String(shown.zoom);
      $('te-zoom-val').textContent = `${shown.zoom.toFixed(2)}×`;
      prune(crop());
      $('te-yaml').textContent = yaml(crop()) || '# no thumbnailCrop: automatic image and site defaults are used';
    }

    function yaml(c: Crop) {
      const fmt = (o: Slot | undefined, pad: string) => [
        ...NUM.filter((k) => o?.[k] !== undefined).map((k) => `${pad}${k}: ${+o![k]!.toFixed(k === 'zoom' ? 2 : 1)}`),
        ...(o?.image ? [`${pad}image: '${o.image.replace(/'/g, "''")}'`] : []),
      ];
      const lines = fmt(c, '  ');
      for (const v of VARIANTS) {
        const vl = fmt(c[v], '    ');
        for (const s of SCREENS) {
          const sl = fmt(c[v]?.[s], '      ');
          if (sl.length) vl.push(`    ${s}:`, ...sl);
        }
        if (vl.length) lines.push(`  ${v}:`, ...vl);
      }
      return lines.length ? ['thumbnailCrop:', ...lines].join('\n') : '';
    }

    const dirty = () => { status.textContent = 'unsaved changes'; status.className = 'te-status font-mono text-sm t-muted'; };
    const clamp = (n: number, a: number, b: number) => Math.min(b, Math.max(a, n));
    // Don't write a value at the selected level that a more specific level overrides for this slot anyway.
    const overridden = (v: Variant, s: Screen, k: keyof Slot) =>
      levels(v, s).slice(0, layerIndex(layer)).some((l) => l?.[k] !== undefined);

    function setFrom(v: Variant, s: Screen, left: number, top: number) {
      const r = region(v, s);
      const t = target();
      if (r.fw < 1 && !overridden(v, s, 'x')) t.x = (clamp(left, 0, 1 - r.fw) / (1 - r.fw)) * 100;
      if (r.fh < 1 && !overridden(v, s, 'y')) t.y = (clamp(top, 0, 1 - r.fh) / (1 - r.fh)) * 100;
      dirty();
      render();
    }

    // Dragging a frame moves it so the same image point stays under the pointer.
    let drag: { v: Variant; s: Screen; sx: number; sy: number; left: number; top: number } | null = null;
    stage.addEventListener('pointerdown', (ev) => {
      ev.preventDefault();
      const area = (el: Element) => { const r = el.getBoundingClientRect(); return r.width * r.height; };
      const hit = document.elementsFromPoint(ev.clientX, ev.clientY)
        .filter((el): el is HTMLElement => el instanceof HTMLElement && el.matches('.te-frame.grab:not([hidden])'))
        .sort((a, b) => area(a) - area(b))[0];
      const frame = hit ?? stage.querySelector<HTMLElement>('.te-frame.grab:not([hidden])');
      if (!frame) return;
      const v = frame.dataset.v as Variant, s = frame.dataset.s as Screen;
      let r = region(v, s);
      if (!hit) {
        // Clicked outside a frame: centre the frame on that point first.
        const rect = stage.getBoundingClientRect();
        setFrom(v, s, (ev.clientX - rect.left) / rect.width - r.fw / 2, (ev.clientY - rect.top) / rect.height - r.fh / 2);
        r = region(v, s);
      }
      drag = { v, s, sx: ev.clientX, sy: ev.clientY, left: r.left, top: r.top };
      stage.setPointerCapture(ev.pointerId);
    });
    stage.addEventListener('pointermove', (ev) => {
      if (!drag) return;
      const rect = stage.getBoundingClientRect();
      setFrom(drag.v, drag.s, drag.left + (ev.clientX - drag.sx) / rect.width, drag.top + (ev.clientY - drag.sy) / rect.height);
    });
    stage.addEventListener('pointerup', () => (drag = null));
    stage.addEventListener('pointercancel', () => (drag = null));

    const setZoom = (z: number) => { target().zoom = clamp(z, 1, 4); dirty(); render(); };
    zoom.addEventListener('input', () => setZoom(Number(zoom.value)));
    stage.addEventListener('wheel', (ev) => {
      ev.preventDefault();
      const f = focus();
      setZoom(eff(f.v, f.s).zoom * (ev.deltaY < 0 ? 1.1 : 1 / 1.1));
    }, { passive: false });

    imageSelect.addEventListener('change', () => {
      const t = target();
      if (imageSelect.value) t.image = imageSelect.value;
      else delete t.image;
      dirty();
      render();
    });

    select.addEventListener('change', () => { entry = entries.find((e) => e.key === select.value)!; status.textContent = ''; render(); });
    document.querySelectorAll<HTMLButtonElement>('#te-variant button').forEach((b) =>
      b.addEventListener('click', () => {
        layer = { v: b.dataset.v as Layer['v'], s: b.dataset.v === 'base' ? 'all' : layer.s };
        render();
      }));
    document.querySelectorAll<HTMLButtonElement>('#te-screen button').forEach((b) =>
      b.addEventListener('click', () => { if (!b.disabled) { layer = { ...layer, s: b.dataset.s as Layer['s'] }; render(); } }));

    $('te-clear').addEventListener('click', () => {
      const t = target();
      for (const k of [...NUM, 'image'] as const) delete t[k];
      dirty();
      render();
    });
    $('te-reset').addEventListener('click', () => { state.set(entry.key, {}); dirty(); render(); });
    $('te-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(yaml(crop()));
      status.textContent = 'copied to clipboard';
    });
    $('te-save').addEventListener('click', async () => {
      status.textContent = 'saving…';
      try {
        const res = await fetch(saveEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ file: entry.file, crop: prune(crop()) }),
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error);
        status.textContent = `saved to ${entry.file}`;
        status.className = 'te-status font-mono text-sm t-accent';
      } catch (err) {
        status.textContent = `save failed: ${err}`;
        status.className = 'te-status font-mono text-sm te-error';
      }
    });

    stageImg.addEventListener('load', render);
    window.addEventListener('resize', render);
    render();
  }
</script>

<style>
  .te-bar { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-bottom: 0.6rem; align-items: end; }
  .te-row { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: end; }
  .te-grow { flex: 1 1 16rem; min-width: 0; }
  .te-field { display: flex; flex-direction: column; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); }
  .te-field select { background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.45rem 0.6rem; width: 100%; }
  .te-tabs { display: inline-flex; border: 1px solid var(--border); border-radius: 0.5rem; overflow: hidden; }
  .te-tabs button { padding: 0.45rem 0.8rem; color: var(--muted); background: var(--surface); }
  .te-tabs button + button { border-left: 1px solid var(--border); }
  .te-tabs button.on { background: var(--accent); color: var(--bg); }
  .te-tabs button:disabled { opacity: 0.35; cursor: not-allowed; }
  .te-editing { margin-bottom: 1rem; }

  .te-stage { position: relative; width: 100%; margin: 0 auto; border-radius: 0.5rem; overflow: hidden; cursor: crosshair; touch-action: none; user-select: none; background: var(--surface); }
  .te-stage img { width: 100%; height: 100%; display: block; opacity: 0.55; pointer-events: none; }
  .te-frame { position: absolute; border: 2px solid; pointer-events: none; opacity: 0.3; box-sizing: border-box; }
  .te-frame[hidden] { display: none; }
  .te-frame span { position: absolute; top: 0; left: 0; font: 600 0.7rem var(--font-mono); padding: 0.1rem 0.35rem; color: #000; white-space: nowrap; }
  .te-frame.active { opacity: 1; }
  .te-frame.grab { pointer-events: auto; cursor: move; box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.15); }
  .te-frame-mobile { border-style: dashed; }
  .te-frame-mobile span { left: auto; right: 0; }
  .te-frame-strip { border-color: #22d3ee; }
  .te-frame-strip span { background: #22d3ee; }
  .te-frame-hero { border-color: #f59e0b; }
  .te-frame-hero span { background: #f59e0b; top: auto; bottom: 0; }

  .te-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.5rem; font: 0.75rem var(--font-mono); margin: 0.6rem 0 1.25rem; }
  .te-key { display: inline-block; width: 1.4rem; height: 0.7rem; border: 2px solid; margin-left: 0.6rem; }
  .te-key-strip { border-color: #22d3ee; }
  .te-key-hero { border-color: #f59e0b; }
  .te-key-mobile { border-style: dashed; border-color: var(--muted); }
  .te-note { opacity: 0.8; }

  .te-controls { display: grid; gap: 0.9rem; }
  .te-zoom input { width: min(100%, 18rem); accent-color: var(--accent); }
  .te-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .te-actions button { padding: 0.45rem 0.9rem; font-size: 0.85rem; }
  .te-status { min-height: 1.25rem; }
  .te-error { color: #f87171; }

