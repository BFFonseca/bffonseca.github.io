---
// Dev-only page (see ./index.ts): interactive thumbnail crop editor.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getThumbnail } from '../../lib/thumbnail';
import { thumbnails } from '../../site.config';
import { SAVE_ENDPOINT } from './index';

const blog = await getCollection('blog');
const projects = await getCollection('projects');

const entries = [
  ...blog.map((e) => ({ e, collection: 'blog' as const })),
  ...projects.map((e) => ({ e, collection: 'projects' as const })),
]
  .map(({ e, collection }) => {
    const thumb = getThumbnail(e);
    if (!thumb || !e.filePath) return undefined;
    return {
      key: `${collection}/${e.id}`,
      collection,
      title: e.data.title + ('draft' in e.data && e.data.draft ? ' (draft)' : ''),
      file: e.filePath.replace(/\\/g, '/'),
      src: thumb.src.src,
      iw: thumb.src.width,
      ih: thumb.src.height,
      crop: e.data.thumbnailCrop ?? {},
    };
  })
  .filter((x) => x !== undefined);

const data = JSON.stringify({ entries, defaults: thumbnails, saveEndpoint: SAVE_ENDPOINT }).replace(/</g, '\\u003c');
---

<BaseLayout title="Thumbnail editor">
  <section class="te">
    <h1 class="section-title text-3xl mb-2">Thumbnail editor</h1>
    <p class="led-accent text-sm mb-8">// dev only · drag a frame to choose what's shown, scroll or use the slider to zoom</p>

    {entries.length === 0 ? (
      <p class="t-muted font-mono">// no posts or projects with images yet.</p>
    ) : (
      <>
        <div class="te-bar">
          <label class="te-field">
            <span>Entry</span>
            <select id="te-entry">
              {entries.map((x) => <option value={x.key}>{x.collection} · {x.title}</option>)}
            </select>
          </label>
          <div class="te-field">
            <span>Editing</span>
            <div class="te-tabs" id="te-layer">
              <button type="button" data-layer="base">Both</button>
              <button type="button" data-layer="strip">Strip only</button>
              <button type="button" data-layer="hero">Banner only</button>
            </div>
          </div>
        </div>

        <div class="te-stage" id="te-stage">
          <img id="te-img" alt="" draggable="false" />
          <div class="te-frame te-frame-strip" data-variant="strip" data-vp="desktop"><span>strip</span></div>
          <div class="te-frame te-frame-strip te-frame-mobile" data-variant="strip" data-vp="mobile"></div>
          <div class="te-frame te-frame-hero" data-variant="hero" data-vp="desktop"><span>banner</span></div>
          <div class="te-frame te-frame-hero te-frame-mobile" data-variant="hero" data-vp="mobile"></div>
        </div>
        <p class="te-legend t-muted">
          <span class="te-key te-key-strip"></span> strip
          <span class="te-key te-key-hero"></span> banner
          <span class="te-key te-key-mobile"></span> dashed = on a phone
        </p>

        <div class="te-controls">
          <label class="te-field te-zoom">
            <span>Zoom <b id="te-zoom-val"></b></span>
            <input id="te-zoom" type="range" min="1" max="4" step="0.01" />
          </label>
          <div class="te-readout font-mono t-muted" id="te-readout"></div>
          <div class="te-actions">
            <button type="button" class="btn-outline" id="te-clear">Clear layer</button>
            <button type="button" class="btn-outline" id="te-reset">Reset all</button>
            <button type="button" class="btn-outline" id="te-copy">Copy YAML</button>
            <button type="button" class="btn-primary" id="te-save">Save to file</button>
          </div>
          <p class="te-status font-mono text-sm" id="te-status"></p>
        </div>

        <h2 class="font-display text-xl font-semibold t-text mt-10 mb-4">Previews</h2>
        <div class="te-previews">
          <figure><figcaption>Strip · desktop</figcaption><div class="te-pv" data-variant="strip" data-vp="desktop"><img alt="" /></div></figure>
          <figure><figcaption>Banner · desktop</figcaption><div class="te-pv" data-variant="hero" data-vp="desktop"><img alt="" /></div></figure>
          <div class="te-pv-row">
            <figure><figcaption>Strip · phone</figcaption><div class="te-pv" data-variant="strip" data-vp="mobile"><img alt="" /></div></figure>
            <figure><figcaption>Banner · phone</figcaption><div class="te-pv" data-variant="hero" data-vp="mobile"><img alt="" /></div></figure>
          </div>
        </div>

        <h2 class="font-display text-xl font-semibold t-text mt-10 mb-2">Frontmatter</h2>
        <pre class="te-yaml" id="te-yaml"></pre>
      </>
    )}
  </section>

  <script type="application/json" id="te-data" set:html={data} />
</BaseLayout>

<script>
  type Crop = { x?: number; y?: number; zoom?: number };
  type FullCrop = Crop & { strip?: Crop; hero?: Crop };
  type Variant = 'strip' | 'hero';
  type Layer = 'base' | Variant;
  type Vp = 'desktop' | 'mobile';
  interface Entry { key: string; collection: 'blog' | 'projects'; title: string; file: string; src: string; iw: number; ih: number; crop: FullCrop }
  interface Defaults { x: number; y: number; zoom: number; height: string | { mobile: string; desktop: string } }

  const dataEl = document.getElementById('te-data');
  if (dataEl) init(JSON.parse(dataEl.textContent!));

  function init({ entries, defaults, saveEndpoint }: { entries: Entry[]; defaults: Record<Variant, Defaults>; saveEndpoint: string }) {
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const select = $<HTMLSelectElement>('te-entry');
    const stage = $<HTMLDivElement>('te-stage');
    const img = $<HTMLImageElement>('te-img');
    const zoom = $<HTMLInputElement>('te-zoom');
    const status = $<HTMLParagraphElement>('te-status');
    const KEYS = ['x', 'y', 'zoom'] as const;

    // Reference sizes of the real boxes on the site (content column is max-w-4xl minus padding).
    const VIEWPORT: Record<Vp, number> = { desktop: 1280, mobile: 375 };
    const content = (vp: Vp) => Math.min(VIEWPORT[vp], 896) - 48;
    const width = (v: Variant, vp: Vp, e: Entry) =>
      v === 'strip' ? content(vp) - 50 /* card padding + border */
        : e.collection === 'blog' ? Math.min(content(vp), 768) : content(vp);
    const height = (v: Variant, vp: Vp) => {
      const h = defaults[v].height;
      const css = typeof h === 'string' ? h : h[vp];
      return css.replace(/([\d.]+)vw/g, (_, n) => `${(Number(n) * VIEWPORT[vp]) / 100}px`);
    };

    // Measure a CSS length (e.g. clamp(...)) in px.
    const probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;visibility:hidden;width:0';
    document.body.append(probe);
    const px = (css: string) => { probe.style.height = css; return probe.getBoundingClientRect().height; };

    const state = new Map(entries.map((e) => [e.key, structuredClone(e.crop) as FullCrop]));
    let entry = entries[0];
    let layer: Layer = 'base';

    const fromHash = new URLSearchParams(location.hash.slice(1));
    const hashEntry = entries.find((e) => e.key === fromHash.get('entry'));
    if (hashEntry) entry = hashEntry;
    if (['base', 'strip', 'hero'].includes(fromHash.get('layer') ?? '')) layer = fromHash.get('layer') as Layer;

    const crop = () => state.get(entry.key)!;
    const target = (l: Layer): Crop => (l === 'base' ? crop() : (crop()[l] ??= {}));
    const eff = (v: Variant) => {
      const c = crop();
      const get = (k: keyof Crop) => c[v]?.[k] ?? c[k] ?? defaults[v][k];
      return { x: get('x'), y: get('y'), zoom: get('zoom') };
    };

    // Visible part of the image for a box, as fractions of the image (same maths as object-fit: cover
    // + object-position x% y% + scale(zoom) around the same point).
    function region(v: Variant, vp: Vp) {
      const W = width(v, vp, entry), H = px(height(v, vp));
      const { x, y, zoom } = eff(v);
      const s = Math.max(W / entry.iw, H / entry.ih) * zoom;
      const fw = Math.min(1, W / (entry.iw * s)), fh = Math.min(1, H / (entry.ih * s));
      return { left: (x / 100) * (1 - fw), top: (y / 100) * (1 - fh), fw, fh };
    }

    function render() {
      const hash = `#entry=${encodeURIComponent(entry.key)}&layer=${layer}`;
      if (location.hash !== hash) history.replaceState(null, '', hash);
      select.value = entry.key;
      if (img.getAttribute('src') !== entry.src) img.src = entry.src;
      stage.style.aspectRatio = `${entry.iw} / ${entry.ih}`;
      stage.style.width = `min(100%, calc(70vh * ${entry.iw / entry.ih}))`;
      document.querySelectorAll<HTMLButtonElement>('#te-layer button').forEach((b) => b.classList.toggle('on', b.dataset.layer === layer));

      stage.querySelectorAll<HTMLElement>('.te-frame').forEach((f) => {
        const v = f.dataset.variant as Variant;
        const r = region(v, f.dataset.vp as Vp);
        Object.assign(f.style, { left: `${r.left * 100}%`, top: `${r.top * 100}%`, width: `${r.fw * 100}%`, height: `${r.fh * 100}%` });
        f.classList.toggle('active', layer === 'base' || layer === v);
      });

      document.querySelectorAll<HTMLElement>('.te-pv').forEach((box) => {
        const v = box.dataset.variant as Variant, vp = box.dataset.vp as Vp;
        const { x, y, zoom } = eff(v);
        box.style.width = `${width(v, vp, entry)}px`;
        box.style.height = height(v, vp);
        const pi = box.querySelector('img')!;
        if (pi.getAttribute('src') !== entry.src) pi.src = entry.src;
        Object.assign(pi.style, { objectPosition: `${x}% ${y}%`, transform: `scale(${zoom})`, transformOrigin: `${x}% ${y}%` });
      });

      const shown = layer === 'base' ? eff('strip') : eff(layer);
      zoom.value = String(shown.zoom);
      $('te-zoom-val').textContent = `${shown.zoom.toFixed(2)}×`;
      const s = eff('strip'), h = eff('hero');
      $('te-readout').textContent = `strip x ${s.x.toFixed(1)} y ${s.y.toFixed(1)} zoom ${s.zoom.toFixed(2)} · banner x ${h.x.toFixed(1)} y ${h.y.toFixed(1)} zoom ${h.zoom.toFixed(2)}`;
      $('te-yaml').textContent = yaml(crop()) || '# no thumbnailCrop: site defaults are used';
    }

    function yaml(c: FullCrop) {
      const fmt = (o: Crop | undefined, pad: string) =>
        KEYS.filter((k) => o?.[k] !== undefined).map((k) => `${pad}${k}: ${+o![k]!.toFixed(k === 'zoom' ? 2 : 1)}`);
      const lines = fmt(c, '  ');
      for (const v of ['strip', 'hero'] as const) {
        const sub = fmt(c[v], '    ');
        if (sub.length) lines.push(`  ${v}:`, ...sub);
      }
      return lines.length ? ['thumbnailCrop:', ...lines].join('\n') : '';
    }

    const dirty = (msg = 'unsaved changes') => { status.textContent = msg; status.className = 'te-status font-mono text-sm t-muted'; };

    // Dragging a frame: move it so the same image point stays under the pointer.
    let drag: { v: Variant; vp: Vp; sx: number; sy: number; left: number; top: number } | null = null;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    function setFrom(v: Variant, vp: Vp, left: number, top: number) {
      const r = region(v, vp);
      const t = target(layer === 'base' ? 'base' : v);
      // In "Both" mode, don't write a shared value that this variant overrides anyway.
      const own = (k: 'x' | 'y') => layer === 'base' && crop()[v]?.[k] !== undefined;
      if (!own('x')) {
        if (r.fw < 1) t.x = (clamp(left, 0, 1 - r.fw) / (1 - r.fw)) * 100;
        else if (t.x === undefined && layer !== 'base') t.x = eff(v).x;
      }
      if (!own('y')) {
        if (r.fh < 1) t.y = (clamp(top, 0, 1 - r.fh) / (1 - r.fh)) * 100;
        else if (t.y === undefined && layer !== 'base') t.y = eff(v).y;
      }
      dirty();
      render();
    }

    stage.addEventListener('pointerdown', (ev) => {
      ev.preventDefault();
      // Frames overlap: grab the smallest one under the pointer (the strip usually sits inside the banner).
      const area = (el: Element) => { const r = el.getBoundingClientRect(); return r.width * r.height; };
      const hit = document.elementsFromPoint(ev.clientX, ev.clientY)
        .filter((el): el is HTMLElement => el instanceof HTMLElement && el.matches('.te-frame.active:not(.te-frame-mobile)'))
        .sort((a, b) => area(a) - area(b))[0];
      const frame = hit
        ?? stage.querySelector<HTMLElement>(`.te-frame.active[data-vp="desktop"]${layer === 'hero' ? '[data-variant="hero"]' : '[data-variant="strip"]'}`)!;
      const v = frame.dataset.variant as Variant, vp = frame.dataset.vp as Vp;
      const rect = stage.getBoundingClientRect();
      let r = region(v, vp);
      if (!hit) {
        // Clicked outside a frame: centre the frame on that point first.
        const cx = (ev.clientX - rect.left) / rect.width, cy = (ev.clientY - rect.top) / rect.height;
        setFrom(v, vp, cx - r.fw / 2, cy - r.fh / 2);
        r = region(v, vp);
      }
      drag = { v, vp, sx: ev.clientX, sy: ev.clientY, left: r.left, top: r.top };
      stage.setPointerCapture(ev.pointerId);
    });
    stage.addEventListener('pointermove', (ev) => {
      if (!drag) return;
      const rect = stage.getBoundingClientRect();
      setFrom(drag.v, drag.vp, drag.left + (ev.clientX - drag.sx) / rect.width, drag.top + (ev.clientY - drag.sy) / rect.height);
    });
    stage.addEventListener('pointerup', () => (drag = null));
    stage.addEventListener('pointercancel', () => (drag = null));

    const setZoom = (z: number) => {
      const t = target(layer);
      t.zoom = clamp(z, 1, 4);
      if (layer !== 'base') { const e = eff(layer); t.x ??= e.x; t.y ??= e.y; }
      dirty();
      render();
    };
    zoom.addEventListener('input', () => setZoom(Number(zoom.value)));
    stage.addEventListener('wheel', (ev) => {
      ev.preventDefault();
      const current = layer === 'base' ? eff('strip').zoom : eff(layer).zoom;
      setZoom(current * (ev.deltaY < 0 ? 1.1 : 1 / 1.1));
    }, { passive: false });

    select.addEventListener('change', () => { entry = entries.find((e) => e.key === select.value)!; status.textContent = ''; render(); });
    document.querySelectorAll<HTMLButtonElement>('#te-layer button').forEach((b) =>
      b.addEventListener('click', () => { layer = b.dataset.layer as Layer; render(); }));

    $('te-clear').addEventListener('click', () => {
      const c = crop();
      if (layer === 'base') KEYS.forEach((k) => delete c[k]);
      else delete c[layer];
      dirty();
      render();
    });
    $('te-reset').addEventListener('click', () => { state.set(entry.key, {}); dirty(); render(); });
    $('te-copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(yaml(crop()));
      status.textContent = 'copied to clipboard';
    });
    $('te-save').addEventListener('click', async () => {
      status.textContent = 'saving…';
      try {
        const res = await fetch(saveEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ file: entry.file, crop: crop() }),
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error);
        status.textContent = `saved to ${entry.file}`;
        status.className = 'te-status font-mono text-sm t-accent';
      } catch (err) {
        status.textContent = `save failed: ${err}`;
        status.className = 'te-status font-mono text-sm te-error';
      }
    });

    img.addEventListener('load', render);
    window.addEventListener('resize', render);
    render();
  }
</script>

<style>
  .te-bar { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; margin-bottom: 1.25rem; align-items: end; }
  .te-field { display: flex; flex-direction: column; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--muted); }
  .te-field select { background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.45rem 0.6rem; max-width: 100%; }
  .te-tabs { display: inline-flex; border: 1px solid var(--border); border-radius: 0.5rem; overflow: hidden; }
  .te-tabs button { padding: 0.45rem 0.8rem; color: var(--muted); background: var(--surface); }
  .te-tabs button + button { border-left: 1px solid var(--border); }
  .te-tabs button.on { background: var(--accent); color: var(--bg); }

  .te-stage { position: relative; width: 100%; margin: 0 auto; border-radius: 0.5rem; overflow: hidden; cursor: crosshair; touch-action: none; user-select: none; background: var(--surface); }
  .te-stage img { width: 100%; height: 100%; display: block; opacity: 0.55; pointer-events: none; }
  .te-frame { position: absolute; border: 2px solid; pointer-events: none; opacity: 0.35; box-sizing: border-box; }
  .te-frame span { position: absolute; top: 0; left: 0; font: 600 0.7rem var(--font-mono); padding: 0.1rem 0.35rem; color: #000; }
  .te-frame.active { opacity: 1; pointer-events: auto; cursor: move; }
  .te-frame.active:not(.te-frame-mobile) { box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.15); }
  .te-frame-mobile { border-style: dashed; pointer-events: none !important; }
  .te-frame-strip { border-color: #22d3ee; }
  .te-frame-strip span { background: #22d3ee; }
  .te-frame-hero { border-color: #f59e0b; }
  .te-frame-hero span { background: #f59e0b; top: auto; bottom: 0; }

  .te-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.5rem; font: 0.75rem var(--font-mono); margin: 0.6rem 0 1.25rem; }
  .te-key { display: inline-block; width: 1.4rem; height: 0.7rem; border: 2px solid; margin-left: 0.6rem; }
  .te-key-strip { border-color: #22d3ee; }
  .te-key-hero { border-color: #f59e0b; }
  .te-key-mobile { border-style: dashed; border-color: var(--muted); }

  .te-controls { display: grid; gap: 0.9rem; }
  .te-zoom input { width: min(100%, 22rem); accent-color: var(--accent); }
  .te-readout { font-size: 0.75rem; }
  .te-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .te-actions button { padding: 0.45rem 0.9rem; font-size: 0.85rem; }
  .te-status { min-height: 1.25rem; }
  .te-error { color: #f87171; }

  .te-previews { display: grid; gap: 1.25rem; }
  .te-previews figure { margin: 0; max-width: 100%; overflow-x: auto; }
  .te-previews figcaption { font: 0.75rem var(--font-mono); color: var(--muted); margin-bottom: 0.4rem; }
  .te-pv-row { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .te-pv { overflow: hidden; border: 1px solid var(--border); border-radius: 0.5rem; background: var(--surface); }
  .te-pv img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .te-yaml { background: var(--surface); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.9rem 1rem; font: 0.8rem var(--font-mono); color: var(--text); white-space: pre-wrap; }
</style>
